<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.cl.dao.TijiaodaanDao">

	<!-- 可根据自己的需求，是否要使用 -->
    <resultMap type="com.cl.entity.TijiaodaanEntity" id="tijiaodaanMap">
        <result property="shijuanmingcheng" column="shijuanmingcheng"/>
        <result property="timujianshu" column="timujianshu"/>
        <result property="daanxinxi" column="daanxinxi"/>
        <result property="tijiaoshijian" column="tijiaoshijian"/>
        <result property="yonghuzhanghao" column="yonghuzhanghao"/>
        <result property="yonghuxingming" column="yonghuxingming"/>
        <result property="jiaoshigonghao" column="jiaoshigonghao"/>
    </resultMap>

    <select id="selectListView"
		resultType="com.cl.entity.view.TijiaodaanView" >

		SELECT  tijiaodaan.* FROM tijiaodaan  tijiaodaan 	        
        <where> 1=1 ${ew.sqlSegment}</where>
	</select>
	
	<select id="selectView"
		resultType="com.cl.entity.view.TijiaodaanView" >
		SELECT * FROM tijiaodaan  tijiaodaan <where> 1=1 ${ew.sqlSegment}</where>
	</select>
	
	<select id="selectGroupBy"
		resultType="com.cl.entity.view.TijiaodaanView" >
		select userid,username,paperid,papername,sum(myscore) myscore,ROUND(sum(case when myscore>0 then 1 else 0 end)/(sum(1)),2) accuracy from examrecord     
        <where> 1=1 ${ew.sqlSegment}</where>
        group by userid,username,paperid,papername  
	</select>

</mapper>
