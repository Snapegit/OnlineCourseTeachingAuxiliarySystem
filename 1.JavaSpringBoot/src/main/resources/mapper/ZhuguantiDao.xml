<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.cl.dao.ZhuguantiDao">

	<!-- 可根据自己的需求，是否要使用 -->
    <resultMap type="com.cl.entity.ZhuguantiEntity" id="zhuguantiMap">
        <result property="shijuanmingcheng" column="shijuanmingcheng"/>
        <result property="fengmian" column="fengmian"/>
        <result property="timujianshu" column="timujianshu"/>
        <result property="timuxiangqing" column="timuxiangqing"/>
        <result property="fabushijian" column="fabushijian"/>
        <result property="jiaoshigonghao" column="jiaoshigonghao"/>
    </resultMap>

    <select id="selectListView"
		resultType="com.cl.entity.view.ZhuguantiView" >

		SELECT  zhuguanti.* FROM zhuguanti  zhuguanti 	        
        <where> 1=1 ${ew.sqlSegment}</where>
	</select>
	
	<select id="selectView"
		resultType="com.cl.entity.view.ZhuguantiView" >
		SELECT * FROM zhuguanti  zhuguanti <where> 1=1 ${ew.sqlSegment}</where>
	</select>
	
	<select id="selectGroupBy"
		resultType="com.cl.entity.view.ZhuguantiView" >
		select userid,username,paperid,papername,sum(myscore) myscore,ROUND(sum(case when myscore>0 then 1 else 0 end)/(sum(1)),2) accuracy from examrecord     
        <where> 1=1 ${ew.sqlSegment}</where>
        group by userid,username,paperid,papername  
	</select>

</mapper>
